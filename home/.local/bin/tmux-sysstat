#!/usr/bin/env bash
# :module: macOS/Linux CPU and memory snapshots for the tmux status bar

case "${1:-}" in
	-h|--help)
		printf 'Usage: tmux-sysstat [client-pid]\nmacOS: sampled CPU usage and kernel memory pressure.\nLinux: CPU usage since the previous snapshot and memory usage.\n'
		exit 0
		;;
esac

# macOS exposes a cheap, system-wide pressure classification, not a RAM-used
# percentage. This is a coarse kernel signal, not Activity Monitor's graph.
if [[ $(uname -s) == Darwin ]]; then
	pressure=$(/usr/sbin/sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null)
	case "$pressure" in
		1) memory='#[fg=green]normal' ;;
		2) memory='#[fg=yellow]warn' ;;
		4) memory='#[fg=red]critical' ;;
		*) memory='#[fg=yellow]?' ;;
	esac

	# Discard top's first CPU sample (since boot). Skip framework/map walks
	# and the process table; take a one-second sample on each status refresh.
	cpu=$(/usr/bin/top -l 2 -s 1 -n 0 -F -R | /usr/bin/awk '
		/^CPU usage:/ { samples++; idle = $(NF-1) + 0 }
		END { if (samples == 2) printf "%.0f%%", 100-idle; else printf "?" }
	')
	printf 'cpu:%s mem:%s#[fg=default]' "$cpu" "$memory"
	exit 0
fi

[[ -r /proc/stat && -r /proc/meminfo ]] || exit 0

# --- CPU usage from /proc/stat delta ---
# per-client cache avoids bogus deltas when multiple tmux clients poll
CACHE="/tmp/tmux-sysstat-cpu-${1:-$$}"
read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat 2>/dev/null || exit 0
total=$(( user + nice + system + idle + iowait + irq + softirq + steal ))
busy=$(( total - idle - iowait ))

if [[ -f "$CACHE" ]]; then
	read -r prev_busy prev_total < "$CACHE"
	d_busy=$(( busy - prev_busy ))
	d_total=$(( total - prev_total ))
	if (( d_total > 0 )); then
		cpu_pct=$(( d_busy * 100 / d_total ))
	else
		cpu_pct=0
	fi
else
	cpu_pct=0
fi
echo "$busy $total" > "$CACHE"

# --- Memory from /proc/meminfo ---
while IFS=': ' read -r key val _; do
	case "$key" in
		MemTotal)     mem_total=$val ;;
		MemAvailable) mem_avail=$val ;;
	esac
done < /proc/meminfo

if (( mem_total > 0 )); then
	mem_pct=$(( (mem_total - mem_avail) * 100 / mem_total ))
else
	mem_pct=0
fi

# --- color by severity ---
color() {
	local pct=$1
	if (( pct >= 80 )); then
		printf '#[fg=red]'
	elif (( pct >= 50 )); then
		printf '#[fg=yellow]'
	else
		printf '#[fg=#686868]'
	fi
}

printf 'c:%s%d%% #[fg=default]m:%s%d%% ' \
	"$(color $cpu_pct)" "$cpu_pct" \
	"$(color $mem_pct)" "$mem_pct"
